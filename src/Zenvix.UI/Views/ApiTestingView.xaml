<UserControl x:Class="Zenvix.UI.Views.ApiTestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- Enabled / Key / Value table used for Params, Headers, Form and Variables -->
        <Style x:Key="KvGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="True" />
            <Setter Property="CanUserDeleteRows" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
        </Style>

        <!-- Simple underlined tabs (one row, never wraps) -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="12,7" Margin="0,0,2,-1">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MethodBadge">
            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" Width="46" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="GET"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Trigger>
                            <Trigger Property="Text" Value="POST"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Trigger>
                            <Trigger Property="Text" Value="DELETE"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + environment -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ENVIRONMENT" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="Name"
                          Width="170" Height="34" />
                <Button Content="Variables" Command="{Binding ToggleEnvironmentEditorCommand}" Style="{DynamicResource Zenvix.Button.Ghost}"
                        Height="34" Padding="14,0" Margin="8,0,0,0" ToolTip="Base URL, API keys, tokens... use them as {{name}}" />
                <Button Content="+ New" Command="{Binding AddEnvironmentCommand}" Style="{DynamicResource Zenvix.Button.Ghost}"
                        Height="34" Padding="12,0" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="API Testing" Style="{DynamicResource Zenvix.Title}" />
                <TextBlock Text="Send requests to local or remote APIs. Use {{variables}} from the environment."
                           Style="{DynamicResource Zenvix.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Environment variables editor -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                Visibility="{Binding IsEnvironmentEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Save variables" Command="{Binding SaveEnvironmentCommand}"
                            Style="{DynamicResource Zenvix.Button.Primary}" Height="32" Padding="14,0" />
                    <TextBlock Style="{StaticResource Caps}" VerticalAlignment="Center">
                        <Run Text="VARIABLES · " /><Run Text="{Binding SelectedEnvironment.Name, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <DataGrid ItemsSource="{Binding EnvVariables}" Style="{StaticResource KvGrid}" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                        <DataGridTextColumn Header="Variable" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Collections & history ===== -->
            <Border Style="{StaticResource Card}" Padding="12">
                <TabControl>
                    <TabItem Header="Collections">
                        <DockPanel Margin="0,10,0,0">
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,10">
                                <Button Content="+ Collection" Command="{Binding NewCollectionCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Height="32" Margin="0,0,4,0" />
                                <Button Content="+ Request" Command="{Binding NewRequestCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Height="32" Margin="4,0,0,0" />
                            </UniformGrid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Collections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" ToolTip="Delete collection" FontSize="10" Padding="6,2"
                                                            Style="{DynamicResource Zenvix.Button.Ghost}" BorderThickness="0"
                                                            Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" BorderThickness="0"
                                                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="Click to rename" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Requests}" Margin="6,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1">
                                                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Delete request" FontSize="9" Padding="5,1"
                                                                        Style="{DynamicResource Zenvix.Button.Ghost}" BorderThickness="0"
                                                                        Command="{Binding DataContext.DeleteRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Command="{Binding DataContext.OpenRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Style="{DynamicResource Zenvix.Button.Ghost}" BorderThickness="0"
                                                                        HorizontalContentAlignment="Left" Padding="6,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ContentPresenter Content="{Binding Method}" ContentTemplate="{StaticResource MethodBadge}" />
                                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="History">
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Top" Content="Clear history" Command="{Binding ClearHistoryCommand}"
                                    Style="{DynamicResource Zenvix.Button.Ghost}" Height="32" Margin="0,0,0,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{DynamicResource Zenvix.Button.Ghost}" BorderThickness="0"
                                                    HorizontalContentAlignment="Left" Padding="6,5" Margin="0,1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentPresenter Content="{Binding Method}" ContentTemplate="{StaticResource MethodBadge}" />
                                                        <TextBlock Text="{Binding Url}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Info}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="46,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ===== Request + response ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- Request -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Height="38" FontWeight="Bold" />
                            <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="8,0"
                                     VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                     mah:TextBoxHelper.Watermark="{}{{baseUrl}}/api/users">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Command="{Binding SendCommand}" Height="38" MinWidth="96" Padding="16,0"
                                    Style="{DynamicResource Zenvix.Button.Primary}">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Send" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSending}" Value="True"><Setter Property="Text" Value="Cancel" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="3" Content="Save" Command="{Binding SaveRequestCommand}" Height="38" Padding="16,0" Margin="8,0,0,0"
                                    Style="{DynamicResource Zenvix.Button.Ghost}" ToolTip="Save to the selected collection" />
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <TextBlock Text="NAME" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"
                                      DisplayMemberPath="Name" Width="180" MinHeight="34" ToolTip="Collection to save into" />
                            <TextBox Text="{Binding RequestName, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TabControl Margin="0,8,0,0">
                            <TabItem Header="Params">
                                <DataGrid ItemsSource="{Binding QueryRows}" Style="{StaticResource KvGrid}" Margin="0,6,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Headers">
                                <DataGrid ItemsSource="{Binding HeaderRows}" Style="{StaticResource KvGrid}" Margin="0,6,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                        <DataGridTextColumn Header="Header" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Body">
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <ComboBox ItemsSource="{Binding BodyKinds}" SelectedItem="{Binding BodyKind}" Width="150" MinHeight="32" />
                                        <TextBlock Text="Form Data: a value starting with @ sends that file, e.g. @C:\photo.png" FontSize="11" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding ShowFormBody, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Grid>
                                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Mono}"
                                                 Visibility="{Binding ShowRawBody, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <DataGrid ItemsSource="{Binding FormRows}" Style="{StaticResource KvGrid}"
                                                  Visibility="{Binding ShowFormBody, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                <DataGridTextColumn Header="Field" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Auth">
                                <StackPanel Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left">
                                    <ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding Auth}" Width="170" Height="32" HorizontalAlignment="Left" />
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBearer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="TOKEN" Style="{StaticResource Caps}" />
                                        <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Width="460"
                                                 VerticalContentAlignment="Center" mah:TextBoxHelper.Watermark="{}{{token}}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsApiKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="KEY NAME" Style="{StaticResource Caps}" />
                                        <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8" Width="460" VerticalContentAlignment="Center" />
                                        <TextBlock Text="VALUE" Style="{StaticResource Caps}" />
                                        <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8" Width="460"
                                                 VerticalContentAlignment="Center" mah:TextBoxHelper.Watermark="{}{{apiKey}}" />
                                        <CheckBox Content="Send as query parameter (instead of a header)" IsChecked="{Binding ApiKeyInQuery}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBasic, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="USERNAME" Style="{StaticResource Caps}" />
                                        <TextBox Text="{Binding BasicUser, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,8" Width="460" VerticalContentAlignment="Center" />
                                        <TextBlock Text="PASSWORD" Style="{StaticResource Caps}" />
                                        <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Width="460" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

                <!-- Response -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasResponse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border CornerRadius="10" Padding="10,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding TimeText}" Margin="14,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SizeText}" Margin="14,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RESPONSE" Style="{StaticResource Caps}" />
                                <mah:ProgressRing Width="14" Height="14" Margin="10,0,0,0"
                                                  Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding ResolvedUrl}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>
                        </DockPanel>
                        <TabControl>
                            <TabItem Header="Body">
                                <TextBox Text="{Binding ResponseBody, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Mono}" Margin="0,6,0,0"
                                         mah:TextBoxHelper.Watermark="Send a request to see the response here." />
                            </TabItem>
                            <TabItem Header="Headers">
                                <DataGrid ItemsSource="{Binding ResponseHeaders}" Style="{StaticResource KvGrid}" CanUserAddRows="False" IsReadOnly="True" Margin="0,6,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="220" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
