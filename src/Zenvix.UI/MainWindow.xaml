<mah:MetroWindow x:Class="Zenvix.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Zenvix.UI"
        xmlns:vm="clr-namespace:Zenvix.ViewModels;assembly=Zenvix.ViewModels"
        xmlns:vm_deploy="clr-namespace:Zenvix.ViewModels.Deployment;assembly=Zenvix.ViewModels"
        xmlns:vm_cont="clr-namespace:Zenvix.ViewModels.Containers;assembly=Zenvix.ViewModels"
        xmlns:views="clr-namespace:Zenvix.UI.Views"
        xmlns:conv="clr-namespace:Zenvix.UI.Converters"
        xmlns:ds="clr-namespace:Zenvix.DesignSystem"
        mc:Ignorable="d"
        Title="ZENVIX - Local Hosting OS" Height="800" Width="1300"
        Icon="/Assets/Icons/zenvix.ico"
        Background="{StaticResource Zenvix.Background}"
        GlowBrush="{StaticResource BorderBrush}"
        WindowStartupLocation="CenterScreen"
        WindowTitleBrush="#4F46E5"
        TitleForeground="#fdfdfdff"
        ShowTitleBar="True" FontFamily="{StaticResource Zenvix.Font}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebsitesViewModel}">
            <views:WebsitesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm_deploy:DeploymentViewModel}">
            <views:DeploymentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm_cont:ContainersViewModel}">
            <views:ContainersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabasesViewModel}">
            <views:DatabasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScalingViewModel}">
            <views:ScalingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApiTestingViewModel}">
            <views:ApiTestingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource Zenvix.Surface}" BorderBrush="{StaticResource Zenvix.Border}" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
 
                <StackPanel Grid.Row="0" Margin="5,10,0,40">
                    <TextBlock Text="ZENVIX" Style="{DynamicResource Zenvix.Title}" Foreground="{StaticResource Zenvix.TextPrimary}" />
                    <TextBlock Text="{Binding AppVersion}" Style="{DynamicResource Zenvix.Subtitle}" Foreground="{StaticResource Zenvix.TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
 
                <StackPanel Grid.Row="1">
                    <RadioButton IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Dashboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Websites" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Website}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Websites" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Deployment" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Rocket}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Deployment" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Databases" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Database}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Databases" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Services" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Server}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Services" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>


                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Scaling" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Server}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Auto Scaling" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="ApiTesting" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Bolt}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="API Testing" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Logs" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logs}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Logs" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource ZenvixSidebar.Button}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Settings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
 
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="96" /> <!-- Topbar -->
                <RowDefinition Height="*" />  <!-- Content -->
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Grid Grid.Row="0" Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live metrics, shown on every page -->
                <UniformGrid Grid.Column="0" Columns="4" Rows="1" VerticalAlignment="Center">
                    <Border Style="{DynamicResource Zenvix.CardStyle}" Padding="16,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="SYSTEM STATUS" Style="{DynamicResource Zenvix.Subtitle}" FontSize="10" />
                            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Zenvix.CardStyle}" Padding="16,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="CPU USAGE" Style="{DynamicResource Zenvix.Subtitle}" FontSize="10" />
                            <TextBlock Text="{Binding State.CpuUsage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Zenvix.CardStyle}" Padding="16,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{DynamicResource Zenvix.Subtitle}" FontSize="10" />
                            <TextBlock Text="{Binding State.RamUsage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Zenvix.CardStyle}" Padding="16,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="HEALTH MONITOR" Style="{DynamicResource Zenvix.Subtitle}" FontSize="10" />
                            <TextBlock Text="{Binding State.SystemHealthStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Update notification: shown when SDK or project updates are available -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Height="34" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="New versions are available - open Settings &gt; SDKs &amp; Updates" Style="{DynamicResource Zenvix.Button.Primary}"
                            Visibility="{Binding Settings.Updates.AvailableCount, Converter={StaticResource PositiveToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Bolt}" Stroke="White" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Settings.Updates.AvailableCount, StringFormat='{}{0} updates available'}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="20" />
                    <Border Width="45" Height="45" CornerRadius="22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                        <TextBlock Text="{Binding Settings.AvatarText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CONTENT HOST -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="40,10,40,40" />

        </Grid>
    </Grid>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout x:Name="DiagnosticFlyout" Header="RUNTIME DIAGNOSTICS" 
                        Position="Right" Width="600" 
                        IsOpen="{Binding IsDiagnosticFlyoutOpen}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Theme="Dark">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SelectedServiceName, StringFormat='Diagnostics for \{0\}'}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Detailed startup logs, environment checks, and crash reports." 
                                   Style="{StaticResource Zenvix.Subtitle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedDiagnosticLogs}" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     Background="Transparent" 
                                     Foreground="#94A3B8" 
                                     BorderThickness="0" 
                                     FontFamily="Consolas" 
                                     FontSize="12" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Copy Logs" Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource Zenvix.Button.Ghost}" Margin="0,0,10,0" Width="120" />
                        <Button Content="Export to File" Command="{Binding ExportDiagnosticsCommand}"
                                Style="{StaticResource Zenvix.Button.Primary}" Width="140" />
                    </StackPanel>
                </Grid>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
</mah:MetroWindow>
