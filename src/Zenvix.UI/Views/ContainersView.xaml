<UserControl x:Class="Zenvix.UI.Views.ContainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Zenvix.Button.Ghost}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Container" Style="{DynamicResource Zenvix.Title}" />
                <TextBlock Text="{Binding DockerDetail}" Style="{DynamicResource Zenvix.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsDockerReady, Converter={StaticResource BoolToVisibilityConverter}}">
                <mah:ProgressRing Width="20" Height="20" Margin="0,0,12,0"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="16,9" Margin="0,0,8,0" />
                <Button Content="+ Custom container" Command="{Binding ToggleCustomFormCommand}" Style="{DynamicResource Zenvix.Button.Primary}" Padding="16,9" />
            </StackPanel>
        </Grid>

        <!-- Docker not available -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="30"
                Visibility="{Binding IsDockerReady, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center">
                <Path Data="{StaticResource HeroIcon.Cube}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="48" Height="48" Stretch="Uniform" />
                <mah:ProgressRing Width="26" Height="26" Margin="0,16,0,0"
                                  Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Visibility="{Binding IsDockerMissing, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,14,0,0">
                    <TextBlock Text="Docker is not installed" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Containers run on Docker. Install Docker Desktop (free for personal use and small teams), start it once, and this page will light up automatically." />
                    <Button Content="Get Docker Desktop" Command="{Binding InstallDockerCommand}" Style="{DynamicResource Zenvix.Button.Primary}"
                            Padding="18,9" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsDockerStopped, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,14,0,0">
                    <TextBlock Text="Docker is installed but not running" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Start the Docker engine. Zenvix checks again every few seconds." />
                    <Button Content="Start Docker Desktop" Command="{Binding StartDockerCommand}" Style="{DynamicResource Zenvix.Button.Primary}"
                            Padding="18,9" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Docker ready -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDockerReady, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>

                <!-- Custom container form -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsCustomFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="RUN ANY IMAGE" Style="{StaticResource Caps}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" mah:TextBoxHelper.Watermark="Name (optional)" />
                            <TextBox Grid.Column="2" Text="{Binding CustomImage, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" mah:TextBoxHelper.Watermark="Image, e.g. wordpress:latest" />
                            <TextBox Grid.Column="4" Text="{Binding CustomPorts, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" mah:TextBoxHelper.Watermark="host:container" />
                        </Grid>
                        <TextBox Text="{Binding CustomEnv, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" Margin="0,10,0,0" AcceptsReturn="True" MinHeight="56"
                                 FontFamily="Consolas" mah:TextBoxHelper.Watermark="Environment variables, one per line: KEY=value" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Cancel" Command="{Binding ToggleCustomFormCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="16,8" Margin="0,0,8,0" />
                            <Button Content="Run container" Command="{Binding RunCustomCommand}" Style="{DynamicResource Zenvix.Button.Primary}" Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logs viewer -->
                <Border Style="{StaticResource Card}" Visibility="{Binding LogsFor, Converter={StaticResource NullToVisibilityConverter}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseLogsCommand}" Style="{StaticResource SmallBtn}" />
                            <TextBlock Text="{Binding LogsFor.Name, StringFormat='LOGS — {0}'}" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Text="{Binding LogsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </DockPanel>
                </Border>

                <!-- Containers -->
                <TextBlock Text="YOUR CONTAINERS" Style="{StaticResource Caps}" Margin="4,0,0,10" />
                <TextBlock Margin="4,0,0,16" Foreground="{DynamicResource TextSecondaryBrush}" Text="No containers yet — start one from a template below.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Containers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Containers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <WrapPanel Margin="17,8,0,0">
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding Image}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Visibility="{Binding Ports, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Ports}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Open" Style="{StaticResource SmallBtn}"
                                                Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Logs" Style="{StaticResource SmallBtn}"
                                                Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Restart" Style="{StaticResource SmallBtn}"
                                                Command="{Binding DataContext.RestartContainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Stop" Style="{StaticResource SmallBtn}"
                                                Command="{Binding DataContext.StopContainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Start" Style="{DynamicResource Zenvix.Button.Primary}" Padding="14,6" Margin="0,0,6,0"
                                                Command="{Binding DataContext.StartContainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                        <Button Content="Remove" Style="{DynamicResource Zenvix.Button.Danger}" Padding="12,6"
                                                Command="{Binding DataContext.RemoveContainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Templates -->
                <TextBlock Text="ONE-CLICK TEMPLATES" Style="{StaticResource Caps}" Margin="4,10,0,10" />
                <ItemsControl ItemsSource="{Binding Templates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="215" Margin="0,0,12,12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Image}" FontSize="10" Margin="0,8,0,0" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" />
                                    <Button Content="Run" Style="{DynamicResource Zenvix.Button.Primary}" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.CreateFromTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Activity -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Style="{StaticResource Caps}" Margin="2,0,0,6" />
                <ListBox x:Name="LogList" ItemsSource="{Binding ActivityLog}" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
