<UserControl x:Class="Zenvix.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:Zenvix.UI.Views"
             xmlns:conv="clr-namespace:Zenvix.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToVisibilityInvertedConverter x:Key="BoolToVisibilityInvertedConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Profile & Main Updates (60% space) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                
                <!-- COMPACT PROFILE CARD -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- HEADER WITH ACCENT BADGE -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="50" Height="50" CornerRadius="25" Background="#1E1B4B" BorderBrush="#4F46E5" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Developer Profile" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Configure your workstation identity and avatar." Style="{DynamicResource Zenvix.Subtitle}" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,25" />

                        <!-- FORM CONTROLS -->
                        <StackPanel Margin="0,0,0,10">
                            <!-- USERNAME -->
                            <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8" />
                            <TextBox Text="{Binding DraftUsername, UpdateSourceTrigger=PropertyChanged}" 
                                     mah:TextBoxHelper.Watermark="e.g. dev_admin" 
                                     mah:ControlsHelper.CornerRadius="8"
                                     mah:ControlsHelper.FocusBorderBrush="{DynamicResource AccentBrush}"
                                     mah:ControlsHelper.MouseOverBorderBrush="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Height="38" Margin="0,0,0,20" Padding="10,0" VerticalContentAlignment="Center" />

                            <!-- FIRST & LAST NAME -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- FIRST NAME -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FIRST NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8" />
                                    <TextBox Text="{Binding DraftFirstName, UpdateSourceTrigger=PropertyChanged}" 
                                             mah:TextBoxHelper.Watermark="First name" 
                                             mah:ControlsHelper.CornerRadius="8"
                                             mah:ControlsHelper.FocusBorderBrush="{DynamicResource AccentBrush}"
                                             mah:ControlsHelper.MouseOverBorderBrush="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             Height="38" Padding="10,0" VerticalContentAlignment="Center" />
                                </StackPanel>

                                <!-- LAST NAME -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LAST NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8" />
                                    <TextBox Text="{Binding DraftLastName, UpdateSourceTrigger=PropertyChanged}" 
                                             mah:TextBoxHelper.Watermark="Last name (optional)" 
                                             mah:ControlsHelper.CornerRadius="8"
                                             mah:ControlsHelper.FocusBorderBrush="{DynamicResource AccentBrush}"
                                             mah:ControlsHelper.MouseOverBorderBrush="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             Height="38" Padding="10,0" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- SAVE BUTTON -->
                        <Button Content="Save Profile" 
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource Zenvix.Button.Primary}"
                                Width="140"
                                Height="36"
                                Cursor="Hand"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Right" />

                        <!-- LIVE AVATAR PREVIEW -->
                        <Border Background="#101323" CornerRadius="10" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Avatar Preview" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="Live changes before saving" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="45" Height="45" CornerRadius="22.5" Background="#1E1B4B" BorderBrush="#4F46E5" BorderThickness="1.5" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DraftAvatarText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DraftFirstName}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding DraftUsername}" Foreground="#94A3B8" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ZENVIX VERSION (was the Version History list) -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Zenvix version" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding AppVersion, StringFormat='Running v{0} · pick a build to update or roll back'}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding GitVersions}" SelectedItem="{Binding SelectedGitVersion}"
                                              DisplayMemberPath="DisplayName" MinHeight="36" Margin="0,0,8,0" IsEnabled="{Binding IsLoadingVersions, Converter={StaticResource InverseBoolConverter}}" />
                                    <Button Grid.Column="1" Content="{Binding InstallVersionText}" IsEnabled="{Binding CanInstallSelectedVersion}" MinWidth="100"
                                            Command="{Binding InstallSpecificVersionCommand}" CommandParameter="{Binding SelectedGitVersion}"
                                            MinHeight="36" Padding="18,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Zenvix.Button.Primary}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- UPDATES CARD -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,20" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Content Area with Padding -->
                        <Border Grid.Row="0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Circular Update Icon (Left - Decreased size) -->
                                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#10B981" Opacity="0.1" />
                                    <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#10B981" BorderThickness="1">
                                        <Path Data="M19 8l-4 4h3c0 3.31-2.69 6-6 6-1.01 0-1.97-.25-2.8-.7l-1.46 1.46C8.97 19.54 10.43 20 12 20c4.42 0 8-3.58 8-8h3l-4-4zM6 12c0-3.31 2.69-6 6-6 1.01 0 1.97.25 2.8.7l1.46-1.46C15.03 4.46 13.57 4 12 4c-4.42 0-8 3.58-8 8H1l4 4 4-4H6z" 
                                              Fill="#10B981" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Version Text Details & Status Text (Center-Left) -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="App Updates" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AppVersion, StringFormat='Current version: v{0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Buttons (Right) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Check Update button -->
                                    <Button Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource Zenvix.Button}"
                                            MinWidth="110" Height="36" Padding="12,0" Cursor="Hand" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <mah:ProgressRing Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <mah:ProgressRing.Style>
                                                    <Style TargetType="mah:ProgressRing">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCheckingUpdate}" Value="True" />
                                                                    <Condition Binding="{Binding IsUpdateAvailable}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </mah:ProgressRing.Style>
                                            </mah:ProgressRing>
                                            <TextBlock Text="Check Update" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Install/Download button -->
                                    <Button Command="{Binding InstallUpdateCommand}"
                                            Style="{StaticResource Zenvix.Button.Primary}"
                                            MinWidth="110" Height="36" Padding="12,0" Cursor="Hand"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <mah:ProgressRing Width="14" Height="14" Margin="0,0,6,0" Foreground="White">
                                                <mah:ProgressRing.Style>
                                                    <Style TargetType="mah:ProgressRing">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCheckingUpdate}" Value="True" />
                                                                    <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                                                                    <Condition Binding="{Binding IsDownloadComplete}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </mah:ProgressRing.Style>
                                            </mah:ProgressRing>
                                            <TextBlock Text="{Binding UpdateButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Edge-to-edge loading bar at the very bottom of the card -->
                        <ProgressBar Grid.Row="1" 
                                     Value="{Binding UpdateProgress}" 
                                     Maximum="100" 
                                     Height="4" 
                                     Background="Transparent"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0"
                                     HorizontalAlignment="Stretch">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCheckingUpdate}" Value="True" />
                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT SIDE: Services & Updates -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22"
                DataContext="{Binding Updates}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <mah:ProgressRing Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding LastChecked}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Check now" Command="{Binding CheckNowCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Height="34" Padding="14,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Services &amp; Updates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Zenvix's own copy vs. the one installed on your system - update either." FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <StackPanel>
                                            <!-- name + version picker -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="32" Margin="8,0"
                                                          ToolTip="Latest two stable versions" />
                                                <Button Grid.Column="2" Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Height="32" MinWidth="92" Padding="12,0"
                                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Zenvix.Button.Ghost}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <!-- comparison: Zenvix copy vs your system -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock Text="IN ZENVIX" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding Installed}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,0" ToolTip="{Binding SystemPath}">
                                                    <StackPanel>
                                                        <TextBlock Text="ON YOUR SYSTEM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding SystemVersion}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="2" Content="Update system" Command="{Binding DataContext.UpdateSystemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanUpdateSystem}" Height="32" Padding="10,0" Style="{DynamicResource Zenvix.Button.Ghost}"
                                                        Visibility="{Binding HasSystem, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ToolTip="Update the copy installed on Windows (outside Zenvix)" />
                                            </Grid>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- PHP extensions: on/off switches, PHP restarts on change -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,4" Margin="0,4,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PhpVersionLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="PHP extensions" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DockPanel>
                                <TextBlock Text="Turn on what your projects need. PHP restarts automatically." FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding PhpExtensionList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" ToolTip="{Binding Description}"
                                                      Width="132" Margin="0,3" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ExtensionsStatus}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding ExtensionsStatus, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- project packages: Laravel, Filament, Livewire -->
                        <StackPanel Visibility="{Binding HasProjectPackages, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,0">
                            <TextBlock Text="YOUR PROJECTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ProjectPackages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="Installed " /><Run Text="{Binding Installed, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="  ·  latest " /><Run Text="{Binding VersionsLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                                               Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Latest}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Button Grid.Column="2" Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Height="32" MinWidth="92" Padding="12,0"
                                                        Style="{DynamicResource Zenvix.Button.Ghost}"
                                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
