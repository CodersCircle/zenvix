<UserControl x:Class="Zenvix.UI.Views.DeploymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:helpers="clr-namespace:Zenvix.UI.Helpers"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style x:Key="SecretField" TargetType="PasswordBox" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Deployment" Style="{DynamicResource Zenvix.Title}" />
            <TextBlock Text="Share a live demo with anyone, or publish your project to a server."
                       Style="{DynamicResource Zenvix.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Background="Transparent"
                    mah:TabControlHelper.Underlined="SelectedTabItem">

            <!-- ═══════════════════ SHARE DEMO ═══════════════════ -->
            <TabItem Header="Share Demo (Free)" mah:HeaderedControlHelper.HeaderFontSize="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource HeroIcon.Globe}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                      Width="30" Height="30" Stretch="Uniform" Margin="0,2,18,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Show your local site to anyone — no hosting needed" FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               Text="Click Share and Zenvix opens a secure Cloudflare tunnel with a public https:// link you can send to a client or teammate. Free, no account, no router or firewall setup. The link stops working as soon as you stop sharing or close Zenvix." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="No websites yet — create one in the Websites section first."
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShareItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding ShareItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Domain}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True" Margin="17,10,0,0"
                                                         Style="{StaticResource Field}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                         Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <mah:ProgressRing Width="20" Height="20" Margin="0,0,10,0"
                                                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="Copy link" Padding="14,8" Margin="0,0,8,0" Style="{DynamicResource Zenvix.Button.Ghost}"
                                                        Command="{Binding DataContext.CopyShareUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="Open" Padding="14,8" Margin="0,0,8,0" Style="{DynamicResource Zenvix.Button.Ghost}"
                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding PublicUrl}"
                                                        Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Padding="16,8" MinWidth="110"
                                                        Command="{Binding DataContext.ToggleShareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Zenvix.Button.Primary}">
                                                            <Setter Property="Content" Value="Share" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                                    <Setter Property="Content" Value="Stop sharing" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Content" Value="Opening..." />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════ DEPLOY TO SERVER ═══════════════════ -->
            <TabItem Header="Deploy to Server" mah:HeaderedControlHelper.HeaderFontSize="15">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile list -->
                    <Border Style="{StaticResource SectionCard}" Padding="12" Margin="0,0,16,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="DEPLOYMENTS" Style="{StaticResource Caps}" Margin="6,4,0,10" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="+ New" Command="{Binding AddProfileCommand}" Style="{DynamicResource Zenvix.Button.Primary}" Padding="14,7" Margin="0,0,8,0" />
                                <Button Content="Remove" Command="{Binding RemoveProfileCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="14,7"
                                        IsEnabled="{Binding HasProfile}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock FontSize="11" Opacity="0.75">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="SSH / SFTP" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Method}" Value="Git">
                                                                <Setter Property="Text" Value="Git push" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Empty state -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCard}"
                            Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40">
                            <Path Data="{StaticResource HeroIcon.Rocket}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="44" Height="44" Stretch="Uniform" />
                            <TextBlock Text="Publish a project to your server" FontWeight="Bold" FontSize="16" Margin="0,14,0,6"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Upload over SSH/SFTP, or push to GitHub/GitLab so your host deploys it."
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="+ New deployment" Command="{Binding AddProfileCommand}" Style="{DynamicResource Zenvix.Button.Primary}"
                                    Padding="18,9" Margin="0,18,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Editor -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="PROJECT" Style="{StaticResource Caps}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Deployment name" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Pick a Zenvix website (optional)" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Websites}" SelectedItem="{Binding SelectedWebsiteForProfile}"
                                                      DisplayMemberPath="Name" Padding="10,7" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Local project folder" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseLocalFolderCommand}"
                                                Style="{DynamicResource Zenvix.Button.Ghost}" Padding="14,7" Margin="8,0,0,0" />
                                        <TextBox Text="{Binding SelectedProfile.LocalPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                    </DockPanel>

                                    <TextBlock Text="Deploy method" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="SSH / SFTP upload" IsChecked="{Binding IsSsh}" Margin="0,0,24,0" GroupName="method" />
                                        <RadioButton Content="Git (GitHub, GitLab, Bitbucket...)" IsChecked="{Binding IsGit}" GroupName="method" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SSH settings -->
                            <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsSsh, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="SERVER (SSH)" Style="{StaticResource Caps}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Host / IP" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                                     mah:TextBoxHelper.Watermark="203.0.113.10 or example.com" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                                     mah:TextBoxHelper.Watermark="root / ubuntu / cpanel user" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Login with" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Password" IsChecked="{Binding IsPasswordAuth}" Margin="0,0,24,0" GroupName="auth" />
                                        <RadioButton Content="Private key file" IsChecked="{Binding IsKeyAuth}" GroupName="auth" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsPasswordAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Password (stored encrypted for your Windows user)" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox Style="{StaticResource SecretField}" helpers:PasswordBoxAssist.BoundPassword="{Binding SshPassword}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsKeyAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Private key (OpenSSH / PEM)" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseKeyCommand}"
                                                    Style="{DynamicResource Zenvix.Button.Ghost}" Padding="14,7" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding SelectedProfile.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                        </DockPanel>
                                        <TextBlock Text="Key passphrase (leave empty if none)" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox Style="{StaticResource SecretField}" helpers:PasswordBoxAssist.BoundPassword="{Binding KeyPassphrase}" />
                                    </StackPanel>

                                    <TextBlock Text="Remote folder" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProfile.RemotePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                             mah:TextBoxHelper.Watermark="/var/www/html or /home/user/public_html" />

                                    <TextBlock Text="Skip these files / folders (comma separated, * allowed)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProfile.Excludes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />

                                    <TextBlock Text="Run after upload (one command per line, runs inside the remote folder)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProfile.PostDeployCommands, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                             AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" FontFamily="Consolas"
                                             mah:TextBoxHelper.Watermark="composer install --no-dev&#x0a;php artisan migrate --force" />

                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Content="Forget server key" Command="{Binding ForgetHostKeyCommand}"
                                                Style="{DynamicResource Zenvix.Button.Ghost}" Padding="10,5" FontSize="11" />
                                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding SelectedProfile.HostFingerprint, StringFormat='Trusted server key: SHA256:{0}', TargetNullValue='Server key will be trusted on first connect.'}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Git settings -->
                            <Border Style="{StaticResource SectionCard}" Visibility="{Binding IsGit, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="REPOSITORY (GIT)" Style="{StaticResource Caps}" />
                                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding GitVersion, StringFormat='Using {0}', TargetNullValue='Git is not installed - get it from git-scm.com to use this method.'}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Repository URL" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.GitRemoteUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                                     mah:TextBoxHelper.Watermark="https://github.com/you/your-project.git" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Branch" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProfile.GitBranch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Commit message (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                             mah:TextBoxHelper.Watermark="Deploy from Zenvix" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Sign-in uses your normal Git login (a browser window opens the first time). Hosts like Vercel, Netlify, Laravel Forge or cPanel Git deploy automatically when you push." />
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                                <mah:ProgressRing Width="22" Height="22" Margin="0,0,12,0"
                                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="16,9" Margin="0,0,8,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Save" Command="{Binding SaveProfilesCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="16,9" Margin="0,0,8,0" />
                                <Button Command="{Binding TestConnectionCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="16,9" Margin="0,0,8,0">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Test connection" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGit}" Value="True">
                                                            <Setter Property="Text" Value="Connect repository" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="Deploy now" Command="{Binding DeployCommand}" Style="{DynamicResource Zenvix.Button.Primary}" Padding="20,9" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Activity log -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="14" Margin="0,8,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Padding="10,3" FontSize="11" />
                    <TextBlock Text="ACTIVITY" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="LogList" ItemsSource="{Binding ActivityLog}" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
