<UserControl x:Class="Zenvix.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:vm="clr-namespace:Zenvix.ViewModels;assembly=Zenvix.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Logs" Style="{DynamicResource Zenvix.Title}" />
                <TextBlock Text="Live logs from Zenvix and every runtime it manages." Style="{DynamicResource Zenvix.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#FEE2E2" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                    <TextBlock Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" Text="{Binding ErrorCount, StringFormat='{}{0} errors'}" />
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="10,5">
                    <TextBlock Foreground="#B45309" FontWeight="SemiBold" FontSize="12" Text="{Binding WarningCount, StringFormat='{}{0} warnings'}" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sources -->
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,4,8">
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshSourcesCommand}" ToolTip="Rescan log files"
                                Style="{DynamicResource Zenvix.Button.Ghost}" Height="28" Padding="8,0">
                            <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <TextBlock Text="LOG FILES" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Group}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Viewer -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     mah:TextBoxHelper.Watermark="Filter text..." mah:TextBoxHelper.ClearTextButton="True" />
                            <ComboBox Width="120" Height="34" Margin="8,0,0,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
                            <CheckBox Content="Live" IsChecked="{Binding AutoRefresh}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Height="34" Padding="14,0" Margin="0,0,6,0" />
                            <Button Content="Copy" Command="{Binding CopyVisibleCommand}" Style="{DynamicResource Zenvix.Button.Ghost}" Height="34" Padding="14,0" Margin="0,0,6,0" />
                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{DynamicResource Zenvix.Button.Primary}" Height="34" Padding="14,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Log lines -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Margin="14,0,14,0">
                        <ListBox x:Name="LineList" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0" Padding="6"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogLine}">
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Error}">
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Warning}">
                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:LogLevel.Debug}">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Footer -->
                    <DockPanel Grid.Row="2" Margin="16,8,16,10">
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SelectedSource.Path}" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
